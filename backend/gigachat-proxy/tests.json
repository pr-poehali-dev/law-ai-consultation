{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "GET keep-alive",
      "method": "GET",
      "path": "/",
      "expectedStatus": 200,
      "expectedBody": {"ok": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "register — missing email",
      "method": "POST",
      "path": "/",
      "body": {"action": "register", "name": "Тест", "email": "notanemail", "password": "secret123", "agreed_to_terms": true},
      "expectedStatus": 400,
      "expectedBody": {"error": "Некорректный email"},
      "bodyMatcher": "partial"
    },
    {
      "name": "register — short password",
      "method": "POST",
      "path": "/",
      "body": {"action": "register", "name": "Иван", "email": "test@example.com", "phone": "+79991234567", "password": "123", "agreed_to_terms": true},
      "expectedStatus": 400,
      "expectedBody": {"error": "Пароль должен быть не менее 6 символов"},
      "bodyMatcher": "partial"
    },
    {
      "name": "login — wrong password",
      "method": "POST",
      "path": "/",
      "body": {"action": "login", "email": "nobody@example.com", "password": "wrongpass"},
      "expectedStatus": 401,
      "expectedBody": {"error": "Неверный email или пароль"},
      "bodyMatcher": "partial"
    },
    {
      "name": "me — unauthorized",
      "method": "POST",
      "path": "/",
      "body": {"action": "me"},
      "expectedStatus": 401,
      "expectedBody": {"error": "Не авторизован"},
      "bodyMatcher": "partial"
    },
    {
      "name": "report — unauthorized",
      "method": "POST",
      "path": "/",
      "body": {"action": "report", "message": "тест"},
      "expectedStatus": 401,
      "expectedBody": {"error": "Не авторизован"},
      "bodyMatcher": "partial"
    },
    {
      "name": "send-otp — bad email",
      "method": "POST",
      "path": "/",
      "body": {"action": "send-otp", "email": "notanemail"},
      "expectedStatus": 400,
      "expectedBody": {"error": "Некорректный email"},
      "bodyMatcher": "partial"
    },
    {
      "name": "verify-otp — wrong code",
      "method": "POST",
      "path": "/",
      "body": {"action": "verify-otp", "email": "test@example.com", "code": "000000"},
      "expectedStatus": 400,
      "expectedBody": {"error": "Неверный или истёкший код"},
      "bodyMatcher": "partial"
    },
    {
      "name": "refund-doc — unauthorized",
      "method": "POST",
      "path": "/",
      "body": {"action": "refund-doc"},
      "expectedStatus": 401,
      "expectedBody": {"error": "Не авторизован"},
      "bodyMatcher": "partial"
    },
    {
      "name": "vapid-public-key",
      "method": "POST",
      "path": "/",
      "body": {"action": "vapid-public-key"},
      "expectedStatus": 200,
      "expectedBody": {"publicKey": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "lawyer-send — 410 moved",
      "method": "POST",
      "path": "/",
      "body": {"action": "lawyer-send", "body": "test"},
      "expectedStatus": 410,
      "bodyMatcher": "partial"
    },
    {
      "name": "legal-docs — 410 moved",
      "method": "POST",
      "path": "/",
      "body": {"action": "legal-docs", "sub": "list", "category": "case_law"},
      "expectedStatus": 410,
      "bodyMatcher": "partial"
    },
    {
      "name": "unknown action — 400",
      "method": "POST",
      "path": "/",
      "body": {"action": "nonexistent"},
      "expectedStatus": 400,
      "bodyMatcher": "partial"
    },
    {
      "name": "mode chat — 410 moved",
      "method": "POST",
      "path": "/",
      "body": {"mode": "chat", "messages": [{"role": "user", "content": "test"}]},
      "expectedStatus": 410,
      "bodyMatcher": "partial"
    }
  ]
}