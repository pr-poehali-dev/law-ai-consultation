{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "register — missing email",
      "method": "POST",
      "path": "/",
      "body": {"action": "register", "name": "Тест", "email": "notanemail", "password": "secret123", "agreed_to_terms": true},
      "expectedStatus": 400,
      "expectedBody": {"error": "Некорректный email"},
      "bodyMatcher": "partial"
    },
    {
      "name": "register — short password",
      "method": "POST",
      "path": "/",
      "body": {"action": "register", "name": "Иван", "email": "test@example.com", "phone": "+79991234567", "password": "123", "agreed_to_terms": true},
      "expectedStatus": 400,
      "expectedBody": {"error": "Пароль должен быть не менее 6 символов"},
      "bodyMatcher": "partial"
    },
    {
      "name": "register — no agreement",
      "method": "POST",
      "path": "/",
      "body": {"action": "register", "name": "Иван", "email": "test@example.com", "phone": "+79991234567", "password": "secret123", "agreed_to_terms": false},
      "expectedStatus": 400,
      "expectedBody": {"error": "Необходимо согласие на обработку персональных данных"},
      "bodyMatcher": "partial"
    },
    {
      "name": "login — wrong password",
      "method": "POST",
      "path": "/",
      "body": {"action": "login", "email": "nobody@example.com", "password": "wrongpass"},
      "expectedStatus": 401,
      "expectedBody": {"error": "Неверный email или пароль"},
      "bodyMatcher": "partial"
    },
    {
      "name": "me — unauthorized",
      "method": "POST",
      "path": "/",
      "body": {"action": "me"},
      "expectedStatus": 401,
      "expectedBody": {"error": "Не авторизован"},
      "bodyMatcher": "partial"
    },
    {
      "name": "report — unauthorized",
      "method": "POST",
      "path": "/",
      "body": {"action": "report", "message": "тест"},
      "expectedStatus": 401,
      "expectedBody": {"error": "Не авторизован"},
      "bodyMatcher": "partial"
    },
    {
      "name": "send-otp — bad email",
      "method": "POST",
      "path": "/",
      "body": {"action": "send-otp", "email": "notanemail"},
      "expectedStatus": 400,
      "expectedBody": {"error": "Некорректный email"},
      "bodyMatcher": "partial"
    },
    {
      "name": "verify-otp — wrong code",
      "method": "POST",
      "path": "/",
      "body": {"action": "verify-otp", "email": "test@example.com", "code": "000000"},
      "expectedStatus": 400,
      "expectedBody": {"error": "Неверный или истёкший код"},
      "bodyMatcher": "partial"
    },
    {
      "name": "refund-doc — unauthorized",
      "method": "POST",
      "path": "/",
      "body": {"action": "refund-doc"},
      "expectedStatus": 401,
      "expectedBody": {"error": "Не авторизован"},
      "bodyMatcher": "partial"
    },
    {
      "name": "vapid-public-key — returns key or 503",
      "method": "POST",
      "path": "/",
      "body": {"action": "vapid-public-key"},
      "expectedStatus": 503,
      "expectedBody": {"error": "Push уведомления не настроены"},
      "bodyMatcher": "partial"
    },
    {
      "name": "push-subscribe-anon — missing data",
      "method": "POST",
      "path": "/",
      "body": {"action": "push-subscribe-anon", "endpoint": ""},
      "expectedStatus": 400,
      "expectedBody": {"error": "Неполные данные подписки"},
      "bodyMatcher": "partial"
    },
    {
      "name": "unknown action — 400",
      "method": "POST",
      "path": "/",
      "body": {"action": "nonexistent-action"},
      "expectedStatus": 400,
      "bodyMatcher": "partial"
    },
    {
      "name": "mode chat — 410 moved",
      "method": "POST",
      "path": "/",
      "body": {"mode": "chat", "messages": [{"role": "user", "content": "test"}]},
      "expectedStatus": 410,
      "bodyMatcher": "partial"
    },
    {
      "name": "mode doc_generate — 410 moved",
      "method": "POST",
      "path": "/",
      "body": {"mode": "doc_generate", "doc_type": "claim", "details": "test"},
      "expectedStatus": 410,
      "bodyMatcher": "partial"
    }
  ]
}
