{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "GET keep-alive",
      "method": "GET",
      "path": "/",
      "expectedStatus": 200,
      "expectedBody": {"ok": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "doc_generate — unauthorized",
      "method": "POST",
      "path": "/",
      "body": {"mode": "doc_generate", "doc_type": "claim", "details": "тест"},
      "expectedStatus": 401
    },
    {
      "name": "doc_generate — missing details",
      "method": "POST",
      "path": "/",
      "body": {"mode": "doc_generate", "doc_type": "claim"},
      "expectedStatus": 401
    },
    {
      "name": "doc_continue — missing partial",
      "method": "POST",
      "path": "/",
      "body": {"mode": "doc_continue", "doc_type": "claim"},
      "expectedStatus": 400
    },
    {
      "name": "file_analyze — missing file",
      "method": "POST",
      "path": "/",
      "body": {"mode": "file_analyze"},
      "expectedStatus": 400
    },
    {
      "name": "file_cleanup",
      "method": "POST",
      "path": "/",
      "body": {"mode": "file_cleanup"},
      "expectedStatus": 200,
      "expectedBody": {"deleted": 0},
      "bodyMatcher": "partial"
    },
    {
      "name": "penalty_calc — unauthorized",
      "method": "POST",
      "path": "/",
      "body": {"mode": "penalty_calc", "calc_data": "тест"},
      "expectedStatus": 401
    },
    {
      "name": "penalty_calc — missing calc_data",
      "method": "POST",
      "path": "/",
      "body": {"mode": "penalty_calc"},
      "expectedStatus": 401
    },
    {
      "name": "rec_doc_generate — unauthorized",
      "method": "POST",
      "path": "/",
      "body": {"mode": "rec_doc_generate", "rec_doc_type": "motion_restore_term", "rec_context": "тест"},
      "expectedStatus": 401
    },
    {
      "name": "doc_ai_review — unauthorized",
      "method": "POST",
      "path": "/",
      "body": {"mode": "doc_ai_review", "doc_content": "тест"},
      "expectedStatus": 401
    },
    {
      "name": "doc_ai_review — missing content",
      "method": "POST",
      "path": "/",
      "body": {"mode": "doc_ai_review"},
      "expectedStatus": 401
    },
    {
      "name": "doc_edit — unauthorized",
      "method": "POST",
      "path": "/",
      "body": {"mode": "doc_edit", "doc_content": "тест", "edit_instruction": "добавь"},
      "expectedStatus": 401
    },
    {
      "name": "unknown mode",
      "method": "POST",
      "path": "/",
      "body": {"mode": "unknown_mode"},
      "expectedStatus": 400
    }
  ]
}