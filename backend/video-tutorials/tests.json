      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "GET список туториалов",
      "method": "GET",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "POST list — возвращает welcome_video и tutorials",
      "method": "POST",
      "path": "/",
      "body": {"action": "list"},
