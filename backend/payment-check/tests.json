{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Missing inv_id",
      "method": "GET",
      "path": "/",
      "expectedStatus": 400,
      "expectedBody": {"error": "inv_id required"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Invalid inv_id format",
      "method": "GET",
      "path": "/?inv_id=abc",
      "expectedStatus": 400,
      "expectedBody": {"error": "inv_id must be integer"},
      "bodyMatcher": "partial"
    }
  ]
}
